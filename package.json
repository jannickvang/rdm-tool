{
  "name": "rdm-tool",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "jannickvang",
  "repository": {
    "type": "git",
    "url": "https://github.com/jannickvang/rdm-tool.git"
  },
  "description": "Art-Net RDM fixture discovery and patching",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && electron-builder --dir",
    "dist": "tsc --noEmit && vite build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.8",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.jvgdesigns.rdmtool",
    "productName": "RDM Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "LICENSE", "to": "licenses/RDM-Tool-LICENSE.txt" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "licenses/THIRD_PARTY_NOTICES.md" },
      { "from": "node_modules/react/LICENSE", "to": "licenses/react-LICENSE.txt" },
      { "from": "node_modules/react-dom/LICENSE", "to": "licenses/react-dom-LICENSE.txt" },
      { "from": "node_modules/scheduler/LICENSE", "to": "licenses/scheduler-LICENSE.txt" },
      { "from": "node_modules/lucide-react/LICENSE", "to": "licenses/lucide-react-LICENSE.txt" },
      { "from": "node_modules/loose-envify/LICENSE", "to": "licenses/loose-envify-LICENSE.txt" },
      { "from": "node_modules/js-tokens/LICENSE", "to": "licenses/js-tokens-LICENSE.txt" },
      { "from": "node_modules/vite/LICENSE.md", "to": "licenses/vite-LICENSE.md" },
      { "from": "node_modules/electron/dist/LICENSE", "to": "licenses/electron-LICENSE.txt" },
      { "from": "node_modules/electron/dist/LICENSES.chromium.html", "to": "licenses/chromium-LICENSES.html" }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "RDM-Tool-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RDM-Tool-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo",
      "artifactName": "RDM-Tool-${version}-linux-${arch}.${ext}"
    }
  }
}
